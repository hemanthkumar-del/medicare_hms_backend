# App Server Configurations
PORT=5000
NODE_ENV=production

# Database Settings (For Docker Compose, MONGO_URI uses service name "mongodb")
MONGO_URI=mongodb://mongodb:27017/medicare_hms
MONGODB_URI=mongodb://mongodb:27017/medicare_hms

# JWT Authentication Keys
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Firebase Credentials JSON (Pass stringified service account credentials)
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary Storage Settings (If applicable)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
